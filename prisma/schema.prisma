generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Package {
  id              Int       @id @default(autoincrement())
  name            String
  description     String    @default("")
  priceTzs        Int
  durationSeconds Int
  maxDevices      Int       @default(1)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  orders          Order[]
  vouchers        Voucher[]
}

model Order {
  id               Int       @id @default(autoincrement())
  phone            String
  packageId        Int
  priceTzsSnapshot Int
  status           String    @default("CREATED")
  createdAt        DateTime  @default(now())
  package          Package   @relation(fields: [packageId], references: [id])
  payment          Payment?
  vouchers         Voucher[]
}

model Payment {
  id                Int       @id @default(autoincrement())
  orderId           Int       @unique
  internalReference String    @unique
  providerReference String?   @unique
  amountTzs         Int
  status            String    @default("PENDING")
  verifiedAt        DateTime?
  createdAt         DateTime  @default(now())
  order             Order     @relation(fields: [orderId], references: [id])
}

model Voucher {
  id         Int       @id @default(autoincrement())
  codeHash   String    @unique
  packageId  Int
  orderId    Int?
  status     String    @default("AVAILABLE")
  redeemedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
  sessions   Session[]
  order      Order?    @relation(fields: [orderId], references: [id])
  package    Package   @relation(fields: [packageId], references: [id])
}

model Session {
  id        Int      @id @default(autoincrement())
  voucherId Int
  deviceId  String
  startedAt DateTime @default(now())
  expiresAt DateTime
  status    String   @default("ACTIVE")
  voucher   Voucher  @relation(fields: [voucherId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  actor     String
  action    String
  meta      String   @default("{}")
  createdAt DateTime @default(now())
}
